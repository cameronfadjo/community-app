{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "community-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@community/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "partner-dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@community/partner-dashboard",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@community/website",
        "dev"
      ],
      "port": 4000
    }
  ]
}
