rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // True only for an account an admin has blocked
    function isRejected(userId) {
      let profile = /databases/$(database)/documents/users/$(userId);
      return exists(profile) && get(profile).data.moderationStatus == 'rejected';
    }

    function isPartner() {
      return isAuthenticated() && request.auth.token.role == 'partner';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Nobody has a public profile. A profile holds an email address, so
      // only its owner and admins can read it.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile. There is no approval step:
      // accounts start approved, and an admin can reject one to block it.
      allow create: if isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.moderationStatus == 'approved';

      // Users can update their own profile (but not moderation status)
      // Only admins can block an account
      allow update: if (isOwner(userId) &&
                        request.resource.data.moderationStatus == resource.data.moderationStatus) ||
                       isAdmin();
    }

    // Venues collection
    match /venues/{venueId} {
      // Anyone can read an approved venue, one at a time or as a list.
      // A list must ask for approved venues only. Admins read all of them.
      allow read: if resource.data.moderationStatus == 'approved' || isAdmin();

      // Admins add and manage venues. Seeding uses the Admin SDK, which
      // skips these rules.
      allow write: if isAdmin();
    }

    // Activities collection (dancing, drag shows, book clubs, ...)
    match /activities/{activityId} {
      // Public: the app is browsable without an account
      allow read: if true;

      // Only admins manage the list
      allow write: if isAdmin();
    }

    // The app is for adults: every event is 18+ or 21+
    function isForAdults(event) {
      return event.tags.minimumAge in [18, 21];
    }

    // Events collection
    match /events/{eventId} {
      // Public: the app is browsable without an account
      allow read: if true;

      // Partners post their own events, which publish immediately.
      // Organizers can host at venues they don't own, so venue ownership
      // is not checked here; admins can take an event down.
      allow create: if isForAdults(request.resource.data) &&
                       (isAdmin() ||
                        (isPartner() &&
                         request.resource.data.organizerId == request.auth.uid &&
                         request.resource.data.status == 'scheduled' &&
                         request.resource.data.activityIds.size() > 0 &&
                         request.resource.data.endsAt > request.resource.data.startsAt));

      // Organizers can edit or cancel their own events, but not hand them to someone else
      allow update: if isForAdults(request.resource.data) &&
                       (isAdmin() ||
                        (isPartner() &&
                         resource.data.organizerId == request.auth.uid &&
                         request.resource.data.organizerId == resource.data.organizerId &&
                         request.resource.data.endsAt > request.resource.data.startsAt));

      allow delete: if isAdmin() ||
                       (isPartner() && resource.data.organizerId == request.auth.uid);
    }

    // Perks unlocked on arrival. One per person per event.
    match /perkRedemptions/{redemptionId} {
      // Only the person who unlocked it. Organizers read totals from
      // eventStats, so they never see which accounts used their perk.
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Any signed-in person can unlock a perk for themselves. The ID ties it
      // to one event and one person, and the details must match the event.
      allow create: if isOwner(request.resource.data.userId) &&
                       !isRejected(request.auth.uid) &&
                       redemptionId == request.resource.data.eventId + '_' + request.auth.uid &&
                       exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
                       matchesEvent(request.resource.data) &&
                       request.resource.data.unlockedAt == request.time &&
                       request.resource.data.expiresAt > request.time &&
                       // The app sets 15 minutes; the extra allows for a phone clock that runs fast
                       request.resource.data.expiresAt <= request.time + duration.value(20, 'm') &&
                       !('redeemedAt' in request.resource.data);

      // The only change allowed is redeeming it once, before it expires
      allow update: if isOwner(resource.data.userId) &&
                       !('redeemedAt' in resource.data) &&
                       request.time < resource.data.expiresAt &&
                       request.resource.data.redeemedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedAt']);

      allow delete: if false;

      function matchesEvent(redemption) {
        let event = get(/databases/$(database)/documents/events/$(redemption.eventId)).data;
        return event.status == 'scheduled' &&
               'perkLabel' in event &&
               redemption.perkLabel == event.perkLabel &&
               request.time < event.endsAt;
      }
    }

    // Perk totals per event, written only by Cloud Functions
    match /eventStats/{eventId} {
      allow read: if isOwner(resource.data.organizerId) || isAdmin();
      allow write: if false;
    }
  }
}
