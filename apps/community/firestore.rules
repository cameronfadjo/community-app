rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // True only for an account an admin has blocked
    function isRejected(userId) {
      let profile = /databases/$(database)/documents/users/$(userId);
      return exists(profile) && get(profile).data.moderationStatus == 'rejected';
    }

    function isPartner() {
      return isAuthenticated() && request.auth.token.role == 'partner';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Nobody has a public profile. A profile holds an email address, so
      // only its owner and admins can read it.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile. There is no approval step:
      // accounts start approved, and an admin can reject one to block it.
      allow create: if isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.moderationStatus == 'approved';

      // Users can update their own profile (but not moderation status)
      // Only admins can block an account
      allow update: if (isOwner(userId) &&
                        request.resource.data.moderationStatus == resource.data.moderationStatus) ||
                       isAdmin();
    }

    // Venues collection
    match /venues/{venueId} {
      // Anyone can read an approved venue, one at a time or as a list.
      // A list must ask for approved venues only. Admins read all of them.
      allow read: if resource.data.moderationStatus == 'approved' || isAdmin();

      // Admins add and manage venues. Loading from a list uses the Admin
      // SDK, which skips these rules.
      allow create, update: if isAdmin() && canBeListed(request.resource.data);
      allow delete: if isAdmin();

      // Events copy the venue's position and perks unlock by it, so a
      // venue can't be approved until it has an address and a position
      // and an admin has verified them
      function canBeListed(venue) {
        return venue.moderationStatus != 'approved' ||
               (venue.detailsVerified == true &&
                venue.location.coordinates is latlng &&
                venue.location.address is string &&
                venue.location.address.size() > 0);
      }
    }

    // Activities collection (dancing, drag shows, book clubs, ...)
    match /activities/{activityId} {
      // Public: the app is browsable without an account
      allow read: if true;

      // Only admins manage the list
      allow write: if isAdmin();
    }

    // The app is for adults: every event is 18+ or 21+
    function isForAdults(event) {
      return event.tags.minimumAge in [18, 21];
    }

    // Events collection
    match /events/{eventId} {
      // Public: the app is browsable without an account
      allow read: if true;

      // Partners post their own events, which publish immediately.
      // Organizers can host at venues they don't own, so venue ownership
      // is not checked here; admins can take an event down.
      allow create: if isForAdults(request.resource.data) &&
                       (isAdmin() ||
                        (isPartner() &&
                         request.resource.data.organizerId == request.auth.uid &&
                         // Only admins post for someone else
                         !('postedOnBehalfBy' in request.resource.data) &&
                         request.resource.data.status == 'scheduled' &&
                         request.resource.data.activityIds.size() > 0 &&
                         request.resource.data.endsAt > request.resource.data.startsAt));

      // Organizers can edit or cancel their own events, but not hand them to someone else
      allow update: if isForAdults(request.resource.data) &&
                       (isAdmin() ||
                        (isPartner() &&
                         resource.data.organizerId == request.auth.uid &&
                         request.resource.data.organizerId == resource.data.organizerId &&
                         !('postedOnBehalfBy' in request.resource.data) &&
                         request.resource.data.endsAt > request.resource.data.startsAt));

      allow delete: if isAdmin() ||
                       (isPartner() && resource.data.organizerId == request.auth.uid);
    }

    // Perks unlocked on arrival. One per person per event.
    match /perkRedemptions/{redemptionId} {
      // Only the person who unlocked it. Organizers read totals from
      // eventStats, so they never see which accounts used their perk.
      //
      // The app looks for a person's perk before they have one, so looking
      // goes by the ID, which ends with their own account's ID. Going by
      // what the record holds would refuse a record that isn't there yet.
      allow get: if isAdmin() ||
                    (isAuthenticated() &&
                     redemptionId.matches('^.+_' + request.auth.uid + '$'));
      allow list: if isOwner(resource.data.userId) || isAdmin();

      // Any signed-in person can unlock a perk for themselves. The ID ties it
      // to one event and one person, and the details must match the event.
      allow create: if isOwner(request.resource.data.userId) &&
                       !isRejected(request.auth.uid) &&
                       redemptionId == request.resource.data.eventId + '_' + request.auth.uid &&
                       exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
                       matchesEvent(request.resource.data) &&
                       request.resource.data.unlockedAt == request.time &&
                       request.resource.data.expiresAt > request.time &&
                       // The app sets 15 minutes; the extra allows for a phone clock that runs fast
                       request.resource.data.expiresAt <= request.time + duration.value(20, 'm') &&
                       isDeletedInTime(request.resource.data) &&
                       !('redeemedAt' in request.resource.data);

      // The only change allowed is redeeming it once, before it expires
      allow update: if isOwner(resource.data.userId) &&
                       !('redeemedAt' in resource.data) &&
                       request.time < resource.data.expiresAt &&
                       request.resource.data.redeemedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedAt']);

      allow delete: if false;

      // The record says who was where, so it must carry the date the
      // database deletes it: thirty days after the event ends. A day either
      // side allows for an end time that changed while someone had the
      // event open, so their perk still unlocks at the door.
      function isDeletedInTime(redemption) {
        let event = get(/databases/$(database)/documents/events/$(redemption.eventId)).data;
        return redemption.deleteAt is timestamp &&
               redemption.deleteAt >= event.endsAt + duration.value(29, 'd') &&
               redemption.deleteAt <= event.endsAt + duration.value(31, 'd');
      }

      function matchesEvent(redemption) {
        let event = get(/databases/$(database)/documents/events/$(redemption.eventId)).data;
        return event.status == 'scheduled' &&
               'perkLabel' in event &&
               redemption.perkLabel == event.perkLabel &&
               request.time < event.endsAt;
      }
    }

    // Anonymous counts of what people do with an event, one document per
    // event per day. Anyone can add one to a count, signed in or not, and
    // nothing else. A count carries no account, phone, or location.
    match /eventSignals/{eventId}/days/{day} {
      // Hosts read the counts for their own events
      allow read: if isAdmin() ||
                     (isPartner() &&
                      get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid);

      allow create: if isCountable(eventId, day) &&
                       hasOnlyCountFields(request.resource.data) &&
                       request.resource.data.eventId == eventId &&
                       request.resource.data.day == day &&
                       isOneMore({}, request.resource.data);

      allow update: if hasOnlyCountFields(request.resource.data) &&
                       request.resource.data.eventId == resource.data.eventId &&
                       request.resource.data.day == resource.data.day &&
                       isRecent(day) &&
                       isOneMore(resource.data, request.resource.data);

      allow delete: if false;

      // The day must be a real one, close to today, for an event that exists
      function isCountable(eventId, day) {
        return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
               isRecent(day) &&
               exists(/databases/$(database)/documents/events/$(eventId));
      }

      // Phones keep their own time and sit in their own time zone, so
      // allow for a clock that is a day out either way
      function isRecent(day) {
        let date = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
        return date > request.time - duration.value(3, 'd') &&
               date < request.time + duration.value(3, 'd');
      }

      function hasOnlyCountFields(data) {
        return data.keys().hasOnly([
          'eventId', 'day', 'views', 'directions', 'perkViews',
          'h00', 'h01', 'h02', 'h03', 'h04', 'h05', 'h06', 'h07', 'h08', 'h09', 'h10', 'h11', 'h12', 'h13', 'h14', 'h15', 'h16', 'h17', 'h18', 'h19', 'h20', 'h21', 'h22', 'h23'
        ]);
      }

      function sumOfHours(data) {
        return data.get('h00', 0) +
               data.get('h01', 0) +
               data.get('h02', 0) +
               data.get('h03', 0) +
               data.get('h04', 0) +
               data.get('h05', 0) +
               data.get('h06', 0) +
               data.get('h07', 0) +
               data.get('h08', 0) +
               data.get('h09', 0) +
               data.get('h10', 0) +
               data.get('h11', 0) +
               data.get('h12', 0) +
               data.get('h13', 0) +
               data.get('h14', 0) +
               data.get('h15', 0) +
               data.get('h16', 0) +
               data.get('h17', 0) +
               data.get('h18', 0) +
               data.get('h19', 0) +
               data.get('h20', 0) +
               data.get('h21', 0) +
               data.get('h22', 0) +
               data.get('h23', 0);
      }

      // Exactly one count goes up by one. A view also adds one to its hour.
      function isOneMore(before, after) {
        let views = after.get('views', 0) - before.get('views', 0);
        let directions = after.get('directions', 0) - before.get('directions', 0);
        let perkViews = after.get('perkViews', 0) - before.get('perkViews', 0);
        return views >= 0 && directions >= 0 && perkViews >= 0 &&
               views + directions + perkViews == 1 &&
               sumOfHours(after) - sumOfHours(before) == views &&
               after.diff(before).affectedKeys().size() <= 4;
      }
    }

    // A host asking to take over events an admin posted for them
    match /eventClaims/{claimId} {
      allow read: if isOwner(resource.data.partnerId) || isAdmin();

      // Partners ask for themselves, once per event or series
      allow create: if isPartner() &&
                       request.resource.data.partnerId == request.auth.uid &&
                       request.resource.data.partnerEmail == request.auth.token.email &&
                       claimId == request.resource.data.claimKey + '_' + request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.note is string &&
                       request.resource.data.note.size() > 0 &&
                       request.resource.data.note.size() <= 500;

      // Only an admin decides
      allow update: if isAdmin();

      // A host can take back a claim nobody has decided yet
      allow delete: if isAdmin() ||
                       (isOwner(resource.data.partnerId) && resource.data.status == 'pending');
    }

    // Perk totals per event. The numbers are written only by Cloud Functions.
    match /eventStats/{eventId} {
      allow read: if isOwner(resource.data.organizerId) || isAdmin();

      // When an admin hands an event over to its host, the totals follow.
      // Nothing else about them can be changed.
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['organizerId', 'updatedAt']);
      allow create, delete: if false;
    }
  }
}
