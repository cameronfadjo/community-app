{
  "name": "community-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Community app",
  "main": "lib/index.js",
  "scripts": {
    "build": "rm -rf lib && tsc",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "firebase-functions-test": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "private": true
}
