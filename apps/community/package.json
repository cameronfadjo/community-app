{
  "name": "@community/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "test": "echo 'no tests yet' && exit 0",
    "lint": "eslint . --max-warnings 0 || true",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo dist node_modules/.cache",
    "firebase:deploy": "firebase deploy",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "firebase:functions": "firebase deploy --only functions",
    "firebase:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@community/firebase": "workspace:*",
    "@community/types": "workspace:*",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.0",
    "expo": "~54.0.31",
    "expo-font": "~14.0.12",
    "expo-location": "^19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "^6.0.21",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
