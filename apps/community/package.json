{
  "name": "@community/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "test": "echo 'no tests yet' && exit 0",
    "lint": "eslint . --max-warnings 0 || true",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo dist node_modules/.cache",
    "firebase:deploy": "firebase deploy",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "firebase:rules:all": "firebase deploy --only firestore:rules,storage:rules",
    "firebase:functions": "cd functions && npm run build && cd .. && firebase deploy --only functions",
    "firebase:hosting": "firebase deploy --only hosting",
    "seed:venues": "npx ts-node scripts/seedVenues.ts"
  },
  "dependencies": {
    "@community/firebase": "workspace:*",
    "@community/types": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.0",
    "dotenv": "^17.2.3",
    "expo": "~54.0.31",
    "expo-image-picker": "^17.0.10",
    "expo-location": "^19.0.8",
    "expo-router": "^6.0.21",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.8.0",
    "geofirestore-core": "^4.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-maps": "^1.26.20",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "~19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
