{
  "name": "@community/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI primitives for the Community Platform Next.js dashboards.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist .turbo",
    "type-check": "tsc --noEmit",
    "lint": "echo 'no lint config yet' && exit 0",
    "test": "echo 'no tests yet' && exit 0"
  },
  "dependencies": {
    "@community/firebase": "workspace:*",
    "@community/types": "workspace:*"
  },
  "peerDependencies": {
    "firebase": "^12.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "firebase": "^12.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.7.3"
  }
}
